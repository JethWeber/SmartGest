<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartGest.Desktop.App"
             xmlns:local="using:SmartGest.Desktop"
             xmlns:theme="using:SmartGest.Desktop.Services"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SgAppBackground" Color="#F5F7FB"/>
          <SolidColorBrush x:Key="SgHeaderBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SgCardBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SgCardBorder" Color="#D9E0EA"/>
          <SolidColorBrush x:Key="SgInputBackground" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SgInputBorder" Color="#C9D2DF"/>
          <SolidColorBrush x:Key="SgTextPrimary" Color="#152238"/>
          <SolidColorBrush x:Key="SgTextSecondary" Color="#46566E"/>
          <SolidColorBrush x:Key="SgTextMuted" Color="#68778D"/>
          <SolidColorBrush x:Key="SgTextOnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SgDivider" Color="#E2E7EF"/>
          <SolidColorBrush x:Key="SgSubtleBackground" Color="#F3F6FA"/>
          <SolidColorBrush x:Key="SgAccent" Color="#1976D2"/>
          <SolidColorBrush x:Key="SgAccentHover" Color="#1565C0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SgAppBackground" Color="#080E1E"/>
          <SolidColorBrush x:Key="SgHeaderBackground" Color="#0D1729"/>
          <SolidColorBrush x:Key="SgCardBackground" Color="#111D31"/>
          <SolidColorBrush x:Key="SgCardBorder" Color="#263750"/>
          <SolidColorBrush x:Key="SgInputBackground" Color="#17253B"/>
          <SolidColorBrush x:Key="SgInputBorder" Color="#334966"/>
          <SolidColorBrush x:Key="SgTextPrimary" Color="#F0F6FF"/>
          <SolidColorBrush x:Key="SgTextSecondary" Color="#C8D7EA"/>
          <SolidColorBrush x:Key="SgTextMuted" Color="#91A2B9"/>
          <SolidColorBrush x:Key="SgTextOnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SgDivider" Color="#2A3950"/>
          <SolidColorBrush x:Key="SgSubtleBackground" Color="#162338"/>
          <SolidColorBrush x:Key="SgAccent" Color="#2196F3"/>
          <SolidColorBrush x:Key="SgAccentHover" Color="#42A5F5"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static theme:ThemeService.SmartGest}">
          <SolidColorBrush x:Key="SgAppBackground" Color="#080E1E"/>
          <SolidColorBrush x:Key="SgHeaderBackground" Color="#0A1628"/>
          <SolidColorBrush x:Key="SgCardBackground" Color="#122038"/>
          <SolidColorBrush x:Key="SgCardBorder" Color="#315173"/>
          <SolidColorBrush x:Key="SgInputBackground" Color="#162945"/>
          <SolidColorBrush x:Key="SgInputBorder" Color="#3C5D80"/>
          <SolidColorBrush x:Key="SgTextPrimary" Color="#F3F7FF"/>
          <SolidColorBrush x:Key="SgTextSecondary" Color="#D0E0F5"/>
          <SolidColorBrush x:Key="SgTextMuted" Color="#A7B9D0"/>
          <SolidColorBrush x:Key="SgTextOnAccent" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SgDivider" Color="#2E4662"/>
          <SolidColorBrush x:Key="SgSubtleBackground" Color="#192C46"/>
          <SolidColorBrush x:Key="SgAccent" Color="#2196F3"/>
          <SolidColorBrush x:Key="SgAccentHover" Color="#64B5F6"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://SmartGest.Desktop/Assets/SmartGest_-_ImaLogo01.ico"
                ToolTipText="SmartGest ERP" />
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml"/>

    <!-- =====================================================
         SMARTGEST · ESTILOS GLOBAIS GLASSMORPHISM
         Paleta: #0A1628 dark | #2196F3 azul | #1565C0 azul escuro
         ===================================================== -->

    <!-- === TEXTBOX === -->
    <Style Selector="TextBox.sg-input">
      <Setter Property="Height"               Value="46"/>
      <Setter Property="FontSize"             Value="13"/>
      <Setter Property="Foreground"           Value="{DynamicResource SgTextPrimary}"/>
      <Setter Property="Background"           Value="{DynamicResource SgInputBackground}"/>
      <Setter Property="BorderBrush"          Value="{DynamicResource SgInputBorder}"/>
      <Setter Property="BorderThickness"      Value="1"/>
      <Setter Property="CornerRadius"         Value="10"/>
      <Setter Property="Padding"              Value="14,0"/>
      <Setter Property="HorizontalAlignment"  Value="Stretch"/>
      <Setter Property="CaretBrush"           Value="#2196F3"/>
      <Setter Property="SelectionBrush"       Value="#402196F3"/>
    </Style>
    <!-- Override do border interno do FluentTheme (evita fundo preto no foco) -->
    <Style Selector="TextBox.sg-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.sg-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.sg-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.sg-input:focus">
      <Setter Property="BorderBrush" Value="#602196F3"/>
      <Setter Property="Background"  Value="#1E2196F3"/>
    </Style>
    <Style Selector="TextBox.sg-input:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource SgCardBorder}"/>
    </Style>

    <!-- === BOTÃO PRIMÁRIO === -->
    <Style Selector="Button.sg-btn-primary">
      <Setter Property="Height"                    Value="46"/>
      <Setter Property="FontSize"                  Value="14"/>
      <Setter Property="FontWeight"                Value="SemiBold"/>
      <Setter Property="Foreground"                Value="White"/>
      <Setter Property="CornerRadius"              Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment"       Value="Stretch"/>
      <Setter Property="Cursor"                    Value="Hand"/>
      <Setter Property="BorderThickness"           Value="1"/>
      <Setter Property="BorderBrush"               Value="#402196F3"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#CC1976D2"/>
          <GradientStop Offset="1" Color="#CC2196F3"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.sg-btn-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#EE1565C0"/>
          <GradientStop Offset="1" Color="#EE1976D2"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.sg-btn-primary:pressed /template/ ContentPresenter">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#FF0D47A1"/>
          <GradientStop Offset="1" Color="#FF1565C0"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- === BOTÃO SECUNDÁRIO === -->
    <Style Selector="Button.sg-btn-secondary">
      <Setter Property="Height"                    Value="46"/>
      <Setter Property="FontSize"                  Value="13"/>
      <Setter Property="FontWeight"                Value="Medium"/>
      <Setter Property="Foreground"                Value="{DynamicResource SgTextSecondary}"/>
      <Setter Property="CornerRadius"              Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment"       Value="Stretch"/>
      <Setter Property="Cursor"                    Value="Hand"/>
      <Setter Property="BorderThickness"           Value="1"/>
      <Setter Property="BorderBrush"               Value="{DynamicResource SgCardBorder}"/>
      <Setter Property="Background"                Value="{DynamicResource SgSubtleBackground}"/>
    </Style>
    <Style Selector="Button.sg-btn-secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#20FFFFFF"/>
    </Style>

    <!-- === BOTÃO LINK === -->
    <Style Selector="Button.sg-link">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground"      Value="#7EB8F7"/>
      <Setter Property="FontSize"        Value="12.5"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Padding"         Value="0"/>
    </Style>
    <Style Selector="Button.sg-link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#42A5F5"/>
    </Style>

    <!-- === BOTÃO DANGER === -->
    <Style Selector="Button.sg-btn-danger">
      <Setter Property="Height"                    Value="46"/>
      <Setter Property="FontSize"                  Value="13"/>
      <Setter Property="FontWeight"                Value="SemiBold"/>
      <Setter Property="Foreground"                Value="White"/>
      <Setter Property="CornerRadius"              Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment"       Value="Stretch"/>
      <Setter Property="Cursor"                    Value="Hand"/>
      <Setter Property="BorderThickness"           Value="1"/>
      <Setter Property="BorderBrush"               Value="#40E53935"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#CCB71C1C"/>
          <GradientStop Offset="1" Color="#CCE53935"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- === CARD GLASS === -->
    <Style Selector="Border.sg-card">
      <Setter Property="CornerRadius"    Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="20"/>
      <Setter Property="BoxShadow"       Value="0 4 24 0 #28000000"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#30FFFFFF"/>
          <GradientStop Offset="0.5" Color="#10FFFFFF"/>
          <GradientStop Offset="1"   Color="#05FFFFFF"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#16FFFFFF"/>
          <GradientStop Offset="1" Color="#0AFFFFFF"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- === CARD GLASS AZUL (destaque/KPI) === -->
    <Style Selector="Border.sg-card-accent">
      <Setter Property="CornerRadius"    Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="20"/>
      <Setter Property="BoxShadow"       Value="0 4 28 0 #402196F3"/>
      <Setter Property="BorderBrush"     Value="#402196F3"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#201976D2"/>
          <GradientStop Offset="1" Color="#142196F3"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- === PROGRESSBAR === -->
    <Style Selector="ProgressBar.sg-progress">
      <Setter Property="Height"          Value="5"/>
      <Setter Property="CornerRadius"    Value="3"/>
      <Setter Property="Background"      Value="{DynamicResource SgCardBorder}"/>
      <Setter Property="Foreground"      Value="#2196F3"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- === LABEL DE CAMPO === -->
    <Style Selector="TextBlock.sg-label">
      <Setter Property="FontSize"    Value="10"/>
      <Setter Property="FontWeight"  Value="Medium"/>
      <Setter Property="Foreground"  Value="{DynamicResource SgTextMuted}"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>

    <!-- === TEXTO DE ERRO === -->
    <Style Selector="TextBlock.sg-error">
      <Setter Property="Foreground"   Value="#FF8A80"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- === SEPARADOR GLASS === -->
    <Style Selector="Border.sg-divider">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0"   Color="Transparent"/>
          <GradientStop Offset="0.5" Color="#22FFFFFF"/>
          <GradientStop Offset="1"   Color="Transparent"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- === SEPARADOR GLASS AZUL (accent) === -->
    <Style Selector="Border.sg-divider-accent">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0"   Color="Transparent"/>
          <GradientStop Offset="0.5" Color="#302196F3"/>
          <GradientStop Offset="1"   Color="Transparent"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- === DATAGRID GLASS === -->
    <Style Selector="DataGrid.sg-grid">
      <Setter Property="Background"           Value="Transparent"/>
      <Setter Property="BorderThickness"      Value="0"/>
      <Setter Property="RowBackground"             Value="Transparent"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SgInputBackground}"/>
      <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
      <Setter Property="Foreground"           Value="{DynamicResource SgTextSecondary}"/>
      <Setter Property="FontSize"             Value="13"/>
    </Style>
    <Style Selector="DataGrid.sg-grid DataGridColumnHeader">
      <Setter Property="Background"   Value="{DynamicResource SgSubtleBackground}"/>
      <Setter Property="Foreground"   Value="{DynamicResource SgTextMuted}"/>
      <Setter Property="FontSize"     Value="10"/>
      <Setter Property="FontWeight"   Value="Medium"/>
      <Setter Property="Padding"      Value="12,10"/>
    </Style>
    <Style Selector="DataGrid.sg-grid DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill"    Value="{DynamicResource SgInputBackground}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGrid.sg-grid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill"    Value="#1E2196F3"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- === SCROLLBAR GLASS === -->
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar /template/ Border">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background"   Value="{DynamicResource SgCardBorder}"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource SgCardBorder}"/>
    </Style>

    <!-- === COMBOBOX GLASS === -->
    <Style Selector="ComboBox.sg-combo">
      <Setter Property="Height"          Value="46"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Foreground"      Value="{DynamicResource SgTextPrimary}"/>
      <Setter Property="Background"      Value="{DynamicResource SgInputBackground}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource SgInputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="10"/>
      <Setter Property="Padding"         Value="14,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ComboBox.sg-combo:focus">
      <Setter Property="BorderBrush" Value="#602196F3"/>
    </Style>
    <Style Selector="ComboBox.sg-combo /template/ Border#Background">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- === CHECKBOX GLASS === -->
    <Style Selector="CheckBox.sg-check">
      <Setter Property="Foreground" Value="{DynamicResource SgTextSecondary}"/>
      <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- === MENU LATERAL (NavigationView / ListBox como nav) === -->
    <Style Selector="ListBoxItem.sg-nav-item">
      <Setter Property="Height"      Value="44"/>
      <Setter Property="FontSize"    Value="13"/>
      <Setter Property="Foreground"  Value="{DynamicResource SgTextSecondary}"/>
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding"     Value="12,0"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem.sg-nav-item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SgInputBackground}"/>
    </Style>
    <Style Selector="ListBoxItem.sg-nav-item:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E2196F3"/>
    </Style>
    <Style Selector="ListBoxItem.sg-nav-item:selected">
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

  </Application.Styles>

</Application>
