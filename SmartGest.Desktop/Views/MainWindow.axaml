<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartGest.Desktop.ViewModels"
        xmlns:views="using:SmartGest.Desktop.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="SmartGest.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SmartGest - Automatize Numeros. Multiplique Resultados."
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        Icon="avares://SmartGest.Desktop/Assets/SmartGest_-_ImaLogo01.ico">

  <Window.Styles>

    <!-- Overlay: escurece o conteudo quando a sidebar esta aberta -->
    <Style Selector="Border.overlay">
      <Setter Property="Background"       Value="#000000"/>
      <Setter Property="Opacity"          Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- O seletor :pointerover na sidebar nao alcanca o overlay irma no Grid.
         Usamos a classe "expanded" que e adicionada via code-behind. -->

    <!-- Sidebar: animacao de largura -->
    <Style Selector="Border.sidebar">
      <Setter Property="Width" Value="64"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sidebar:pointerover">
      <Setter Property="Width" Value="240"/>
    </Style>

    <!-- Logo completo: visivel so quando hover -->
    <Style Selector="Image.logo-full">
      <Setter Property="Opacity"  Value="0"/>
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sidebar:pointerover Image.logo-full">
      <Setter Property="Opacity"  Value="1"/>
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- ImaLogo pequeno: some no hover -->
    <Style Selector="Image.logo-icon">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sidebar:pointerover Image.logo-icon">
      <Setter Property="Opacity" Value="0"/>
    </Style>

    <!-- Labels de texto: ocultos quando fechado -->
    <Style Selector="TextBlock.menu-label">
      <Setter Property="Opacity"  Value="0"/>
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sidebar:pointerover TextBlock.menu-label">
      <Setter Property="Opacity"  Value="1"/>
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Info do utilizador no rodape -->
    <Style Selector="StackPanel.user-info">
      <Setter Property="Opacity"  Value="0"/>
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseInOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sidebar:pointerover StackPanel.user-info">
      <Setter Property="Opacity"  Value="1"/>
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- ListBoxItem base -->
    <Style Selector="ListBoxItem.menu-item">
      <Setter Property="Padding"      Value="0"/>
      <Setter Property="Height"       Value="44"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin"       Value="0,2"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="Background"   Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Circulo do icone -->
    <Style Selector="Border.icon-circle">
      <Setter Property="Width"        Value="36"/>
      <Setter Property="Height"       Value="36"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background"   Value="#F0F4F8"/>
      <Setter Property="BoxShadow"    Value="0 2 6 0 #18000000"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:pointerover Border.icon-circle">
      <Setter Property="Background" Value="#E3F0FF"/>
      <Setter Property="BoxShadow"  Value="0 3 8 0 #28000000"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:selected Border.icon-circle">
      <Setter Property="Background" Value="#2196F3"/>
      <Setter Property="BoxShadow"  Value="0 3 10 0 #402196F3"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:selected:pointerover Border.icon-circle">
      <Setter Property="Background" Value="#1E88E5"/>
    </Style>

    <!-- Icones -->
    <Style Selector="ListBoxItem.menu-item mi|MaterialIcon">
      <Setter Property="Foreground" Value="#7B8FA6"/>
      <Setter Property="Width"      Value="18"/>
      <Setter Property="Height"     Value="18"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:pointerover mi|MaterialIcon">
      <Setter Property="Foreground" Value="#2196F3"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:selected mi|MaterialIcon">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Texto dos itens -->
    <Style Selector="ListBoxItem.menu-item TextBlock.menu-label">
      <Setter Property="Foreground" Value="#44546A"/>
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:selected TextBlock.menu-label">
      <Setter Property="Foreground" Value="#2196F3"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ListBoxItem.menu-item:pointerover TextBlock.menu-label">
      <Setter Property="Foreground" Value="#2196F3"/>
    </Style>

  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CaixaViewModel}">
      <views:CaixaView/>
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Grid raiz -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="64"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Conteudo principal -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

    <!-- Overlay escuro: cobre tudo, fica entre conteudo e sidebar.
         A opacidade e controlada via code-behind (PointerEntered/Exited). -->
    <Border x:Name="SidebarOverlay"
            Classes="overlay"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ZIndex="5"/>

    <!-- SIDEBAR -->
    <Border x:Name="Sidebar"
            Classes="sidebar"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ZIndex="10"
            HorizontalAlignment="Left"
            Background="#FFFFFF"
            Padding="12,16"
            ClipToBounds="True"
            BoxShadow="2 0 16 0 #14000000">

      <Grid RowDefinitions="Auto, *, Auto">

        <!-- Logo -->
        <Border Grid.Row="0"
                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                Padding="0,0,0,14" Margin="0,0,0,12"
                Height="52">
          <Grid>
            <Image Classes="logo-icon"
                   Source="/Assets/SmartGest_-_ImaLogo1.png"
                   Width="32" Height="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"/>
            <Image Classes="logo-full"
                   Source="/Assets/smartgest_logo.png"
                   Height="32"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Stretch="Uniform"/>
          </Grid>
        </Border>

        <!-- Menu -->
        <ListBox Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectedIndex="{Binding SelectedMenuIndex}">

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="ViewDashboard" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="Dashboard Principal" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="CashRegister" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="Caixa" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="ScaleBalance" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="Balancete" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="ChartBarStacked" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="Balanco Patrimonial" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="FileChartOutline" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="DRE" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="Bank" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="Contas e Bancos" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

          <ListBoxItem Classes="menu-item">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="2,0">
              <Border Classes="icon-circle">
                <mi:MaterialIcon Kind="CogOutline" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Classes="menu-label" Text="Configuracoes" VerticalAlignment="Center"/>
            </StackPanel>
          </ListBoxItem>

        </ListBox>

        <!-- Perfil -->
        <Border Grid.Row="2"
                BorderBrush="#F0F0F0" BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="#E3F2FD"
                    BoxShadow="0 2 6 0 #18000000"
                    HorizontalAlignment="Center">
              <TextBlock Text="AB"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         FontWeight="Bold"
                         Foreground="#2196F3"/>
            </Border>
            <StackPanel Classes="user-info" VerticalAlignment="Center">
              <TextBlock Text="{Binding UsuarioNome}"
                         FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
              <TextBlock Text="Administrador"
                         FontSize="11" Foreground="#888888"/>
            </StackPanel>
          </StackPanel>
        </Border>

      </Grid>
    </Border>

  </Grid>
</Window>