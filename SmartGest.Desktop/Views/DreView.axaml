<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartGest.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="SmartGest.Desktop.Views.DreView"
             x:DataType="vm:DreViewModel">

  <UserControl.Styles>

    <!-- ── Card base ────────────────────────────────────────────────── -->
    <Style Selector="Border.sg-card">
      <Setter Property="CornerRadius"    Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="20"/>
      <Setter Property="BoxShadow"       Value="0 4 24 0 #28000000"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#30FFFFFF"/>
          <GradientStop Offset="0.5" Color="#10FFFFFF"/>
          <GradientStop Offset="1"   Color="#05FFFFFF"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#16FFFFFF"/>
          <GradientStop Offset="1" Color="#0AFFFFFF"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- ── Títulos de secção ─────────────────────────────────────────── -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#C8DCFF"/>
      <Setter Property="Margin"     Value="0,0,0,12"/>
      <Setter Property="LetterSpacing" Value="0.3"/>
    </Style>

    <!-- ── Labels e valores dos cards ───────────────────────────────── -->
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize"   Value="10.5"/>
      <Setter Property="Foreground" Value="#60FFFFFF"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize"   Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <!-- ── Botão primário ───────────────────────────────────────────── -->
    <Style Selector="Button.btn-primary">
      <Setter Property="Background"      Value="#2196F3"/>
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="16,8"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E88E5"/>
    </Style>

    <!-- ── Botão outline (exportar) ─────────────────────────────────── -->
    <Style Selector="Button.btn-outline">
      <Setter Property="Background"      Value="White"/>
      <Setter Property="Foreground"      Value="#1A2E5A"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="14,8"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush"     Value="#DDE3EE"/>
    </Style>
    <Style Selector="Button.btn-outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F4F6FA"/>
    </Style>

    <!-- ── Filtros ──────────────────────────────────────────────────── -->
    <Style Selector="ComboBox.sg-filter, TextBox.sg-filter">
      <Setter Property="Background"      Value="#12FFFFFF"/>
      <Setter Property="BorderBrush"     Value="#25FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="10,6"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Height"          Value="34"/>
    </Style>

    <!-- ── Linhas alternadas ─────────────────────────────────────────── -->
    <Style Selector="DataGridRow:nth-child(odd)">
      <Setter Property="Background" Value="#08FFFFFF"/>
    </Style>    <Style Selector="DataGridRow:pointerover">
      <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer Background="Transparent">
    <Border Padding="28,24">
      <StackPanel Spacing="20">

        <!-- ══════════════════════════════════════════════════════════════
             CABEÇALHO
             ══════════════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Demonstração de Resultados"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#F0F6FF"/>
            <TextBlock Text="Resultados por natureza — receitas, custos e resultado líquido do exercício"
                       FontSize="12" Foreground="#55FFFFFF" Margin="0,4,0,0"/>
          </StackPanel>

          <!-- Botão de exportação -->
          <Button Grid.Column="1" Classes="btn-outline"
                  Command="{Binding ExportarCommand}"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="FileExcelOutline" Width="14" Height="14"/>
              <TextBlock Text="Exportar" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             CARDS DE MÉTRICAS  (3 colunas)
             ══════════════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="*, 12, *, 12, *">

          <!-- Total Receitas -->
          <Border Grid.Column="0" Classes="sg-card">
            <Grid ColumnDefinitions="*, 100">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="metric-label" Text="Total Receitas"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <TextBlock Classes="metric-value"
                             Text="{Binding TotalReceitas}"
                             Foreground="#81C784"/>
                  <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Classes="metric-value"
                             Text="{Binding ReceitasVariacao}"
                             FontSize="10" FontWeight="SemiBold"
                             Foreground="#81C784"/>
                  </Border>
                </StackPanel>
              </StackPanel>
              <lvc:CartesianChart Grid.Column="1" Height="50"
                                  Series="{Binding SparklineReceitas}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Total Custos -->
          <Border Grid.Column="2" Classes="sg-card">
            <Grid ColumnDefinitions="*, 100">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="metric-label" Text="Total Custos"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <TextBlock Classes="metric-value"
                             Text="{Binding TotalCustos}"
                             Foreground="#EF9A9A"/>
                  <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CustosVariacao}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#EF9A9A"/>
                  </Border>
                </StackPanel>
              </StackPanel>
              <lvc:CartesianChart Grid.Column="1" Height="50"
                                  Series="{Binding SparklineCustos}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Resultado Líquido -->
          <Border Grid.Column="4" Classes="sg-card">
            <Grid ColumnDefinitions="*, 100">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="metric-label" Text="Resultado Líquido"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <TextBlock Classes="metric-value"
                             Text="{Binding ResultadoLiquido}"
                             Foreground="{Binding CorResultado}"/>
                    <Border Background="#14FFFFFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultadoVariacao}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#1A2E5A"/>
                  </Border>
                </StackPanel>
              </StackPanel>
              <lvc:CartesianChart Grid.Column="1" Height="50"
                                  Series="{Binding SparklineResultado}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             GRÁFICO MENSAL
             ══════════════════════════════════════════════════════════════ -->
        <Border Classes="sg-card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Evolução Mensal — Receitas vs Custos"
                       Classes="section-title"/>
            <lvc:CartesianChart Height="220"
                                Series="{Binding SeriesGrafico}"
                                XAxes="{Binding EixoX}"
                                YAxes="{Binding EixoY}"
                                TooltipPosition="Top"
                                Background="Transparent"/>
          </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             FILTROS
             ══════════════════════════════════════════════════════════════ -->
        <Border Classes="sg-card" Padding="16,12">
          <Grid ColumnDefinitions="Auto, 8, Auto, 8, *, 8, *, 8, Auto">

            <!-- Período -->
            <ComboBox Grid.Column="0"
                      Classes="sg-filter"
                      SelectedIndex="{Binding FiltroPeriodoIndex}"
                      Width="140">
              <ComboBoxItem Content="Anual"/>
              <ComboBoxItem Content="Semestral"/>
              <ComboBoxItem Content="Trimestral"/>
              <ComboBoxItem Content="Mensal"/>
            </ComboBox>

            <!-- Ano -->
            <ComboBox Grid.Column="2"
                      Classes="sg-filter"
                      SelectedIndex="{Binding FiltroAnoIndex}"
                      Width="90">
              <ComboBoxItem Content="2025"/>
              <ComboBoxItem Content="2024"/>
              <ComboBoxItem Content="2023"/>
            </ComboBox>

            <!-- Data inicial -->
            <DatePicker Grid.Column="4"
                        SelectedDate="{Binding FiltroDataInicio}"
                        FontSize="12" Height="34" CornerRadius="7"/>

            <!-- Data final -->
            <DatePicker Grid.Column="6"
                        SelectedDate="{Binding FiltroDataFim}"
                        FontSize="12" Height="34" CornerRadius="7"/>

            <!-- Botão Filtrar -->
            <Button Grid.Column="8"
                    Classes="btn-primary"
                    Command="{Binding FiltrarCommand}"
                    Padding="14,6">
              <TextBlock Text="Filtrar" FontSize="12" FontWeight="SemiBold"/>
            </Button>

          </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             TABELA DE RUBRICAS
             ══════════════════════════════════════════════════════════════ -->
        <Border Classes="sg-card">
          <DockPanel>

            <!-- Cabeçalho da secção -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
              <TextBlock Grid.Column="0"
                         Text="Rubricas da DRE"
                         Classes="section-title" Margin="0"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding TotalLinhasTexto}"
                         FontSize="11" Foreground="#9AA0AB"
                         VerticalAlignment="Center"/>
            </Grid>

            <DataGrid ItemsSource="{Binding LinhasFiltradas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="Transparent"
                      FontSize="12"
                      MinHeight="280">

              <DataGrid.Columns>

                <!-- Código -->
                <DataGridTemplateColumn Header="Cód." Width="55">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <TextBlock Text="{Binding Codigo}"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 Foreground="#C8DCFF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Descrição -->
                <DataGridTemplateColumn Header="Descrição" Width="2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <TextBlock Text="{Binding Descricao}"
                                 VerticalAlignment="Center"
                                 Foreground="#C8DCFF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Grupo (badge colorida) -->
                <DataGridTemplateColumn Header="Grupo" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <Border Background="{Binding FundoGrupo}"
                              CornerRadius="4" Padding="8,3"
                              HorizontalAlignment="Left"
                              Margin="6,4">
                        <TextBlock Text="{Binding Grupo}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding CorGrupo}"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Valor Orçado -->
                <DataGridTemplateColumn Header="Orçado (Kzs)" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <TextBlock Text="{Binding ValorOrcadoFmt}"
                                 VerticalAlignment="Center"
                                 TextAlignment="Right"
                                 Foreground="#90AECF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Valor Realizado -->
                <DataGridTemplateColumn Header="Realizado (Kzs)" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <TextBlock Text="{Binding ValorRealizadoFmt}"
                                 VerticalAlignment="Center"
                                 TextAlignment="Right"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding CorValor}"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Desvio -->
                <DataGridTemplateColumn Header="Desvio (Kzs)" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <TextBlock Text="{Binding DesvioFmt}"
                                 VerticalAlignment="Center"
                                 TextAlignment="Right"
                                 FontWeight="Medium"
                                 Foreground="{Binding CorDesvio}"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- % Execução -->
                <DataGridTemplateColumn Header="Execução" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:DreLinhaItem">
                      <TextBlock Text="{Binding ExecucaoFmt}"
                                 VerticalAlignment="Center"
                                 TextAlignment="Right"
                                 Foreground="#90AECF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

              </DataGrid.Columns>
            </DataGrid>

          </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             RODAPÉ DE TOTAIS
             ══════════════════════════════════════════════════════════════ -->
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
