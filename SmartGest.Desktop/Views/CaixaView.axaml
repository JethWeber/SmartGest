<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartGest.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="SmartGest.Desktop.Views.CaixaView"
             x:DataType="vm:CaixaViewModel">

  <UserControl.Styles>

    <!-- ── Card base (idêntico ao DashboardView) ───────────────────── -->
    <Style Selector="Border.sg-card">
      <Setter Property="CornerRadius"    Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="20"/>
      <Setter Property="BoxShadow"       Value="0 4 24 0 #28000000"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#30FFFFFF"/>
          <GradientStop Offset="0.5" Color="#10FFFFFF"/>
          <GradientStop Offset="1"   Color="#05FFFFFF"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#16FFFFFF"/>
          <GradientStop Offset="1" Color="#0AFFFFFF"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- ── Títulos de secção ────────────────────────────────────────── -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#C8DCFF"/>
      <Setter Property="Margin"     Value="0,0,0,12"/>
      <Setter Property="LetterSpacing" Value="0.3"/>
    </Style>

    <!-- ── Labels e valores dos cards de métrica ────────────────────── -->
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize"   Value="10.5"/>
      <Setter Property="Foreground" Value="#60FFFFFF"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize"   Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <!-- ── Variação percentual (tag verde / vermelha) ───────────────── -->
    <Style Selector="Border.badge-positive">
      <Setter Property="Background"   Value="#14FFFFFF"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding"      Value="6,2"/>
    </Style>
    <Style Selector="Border.badge-negative">
      <Setter Property="Background"   Value="#14FFFFFF"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding"      Value="6,2"/>
    </Style>

    <!-- ── Botão primário ───────────────────────────────────────────── -->
    <Style Selector="Button.btn-primary">
      <Setter Property="Background"   Value="#2196F3"/>
      <Setter Property="Foreground"   Value="White"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Padding"      Value="16,8"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E88E5"/>
    </Style>

    <!-- ── Botão de perigo (saída) ──────────────────────────────────── -->
    <Style Selector="Button.btn-danger">
      <Setter Property="Background"   Value="#FFEBEE"/>
      <Setter Property="Foreground"   Value="#E53935"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Padding"      Value="16,8"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Cursor"       Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFCDD2"/>
    </Style>

    <!-- ── ComboBox / TextBox de filtro ─────────────────────────────── -->
    <Style Selector="ComboBox.sg-filter, TextBox.sg-filter">
      <Setter Property="Background"     Value="#12FFFFFF"/>
      <Setter Property="BorderBrush"    Value="#25FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"   Value="7"/>
      <Setter Property="Padding"        Value="10,6"/>
      <Setter Property="FontSize"       Value="12"/>
      <Setter Property="Height"         Value="34"/>
    </Style>

    <!-- ── Linhas alternadas na DataGrid ────────────────────────────── -->
    <Style Selector="DataGridRow:nth-child(odd)">
      <Setter Property="Background" Value="#08FFFFFF"/>
    </Style>

    <!-- ── Pill de tipo de lançamento ───────────────────────────────── -->
    <Style Selector="Border.pill-entrada">
      <Setter Property="Background"   Value="#E8F5E9"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding"      Value="8,2"/>
    </Style>
    <Style Selector="Border.pill-saida">
      <Setter Property="Background"   Value="#FFEBEE"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding"      Value="8,2"/>
    </Style>

  </UserControl.Styles>

  <ScrollViewer Background="Transparent">
    <Border Padding="28,24">
      <StackPanel Spacing="20">

        <!-- ══════════════════════════════════════════════════════════
             CABEÇALHO
             ══════════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="*, Auto">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Caixa"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#F0F6FF"/>
            <TextBlock Text="Gestão de entradas e saídas de caixa"
                       FontSize="12" Foreground="#55FFFFFF" Margin="0,4,0,0"/>
          </StackPanel>

          <!-- Botão Nova Transação -->
          <Button x:Name="BtnNovaTransacao" Grid.Column="1"
                  Command="{Binding NovaTransacaoCommand}"
                  VerticalAlignment="Center"
                  Cursor="Hand"
                  BorderThickness="0"
                  CornerRadius="10"
                  Padding="20,12">
            <Button.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#2196F3" Offset="0"/>
                <GradientStop Color="#1A73E8" Offset="1"/>
              </LinearGradientBrush>
            </Button.Background>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="CashPlus" Width="18" Height="18" Foreground="White"/>
              <TextBlock Text="Nova Transação" FontSize="13" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             CARDS DE MÉTRICAS  (3 colunas)
             ══════════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="*, 12, *, 12, *">

          <!-- Saldo em Caixa -->
          <Border Grid.Column="0" Classes="sg-card">
            <Grid RowDefinitions="Auto, Auto, 6, Auto, 44">
              <TextBlock Grid.Row="0" Classes="metric-label" Text="Saldo em Caixa"/>
              <TextBlock Grid.Row="1" Classes="metric-value"
                         Text="{Binding SaldoCaixa}" Foreground="#64B5F6"/>
              <Border Grid.Row="3" CornerRadius="4" Padding="6,2"
                      Background="{Binding FundoSaldoVar}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SaldoVariacao}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding CorSaldoVar}"/>
              </Border>
              <lvc:CartesianChart Grid.Row="4"
                                  Series="{Binding SparklineSaldo}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Entradas do Dia -->
          <Border Grid.Column="2" Classes="sg-card">
            <Grid RowDefinitions="Auto, Auto, 6, Auto, 44">
              <TextBlock Grid.Row="0" Classes="metric-label" Text="Entradas do Dia"/>
              <TextBlock Grid.Row="1" Classes="metric-value"
                         Text="{Binding EntradasDia}" Foreground="#81C784"/>
              <Border Grid.Row="3" CornerRadius="4" Padding="6,2"
                      Background="{Binding FundoEntradasVar}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding EntradasVariacao}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding CorEntradasVar}"/>
              </Border>
              <lvc:CartesianChart Grid.Row="4"
                                  Series="{Binding SparklineEntradas}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Saídas do Dia -->
          <Border Grid.Column="4" Classes="sg-card">
            <Grid RowDefinitions="Auto, Auto, 6, Auto, 44">
              <TextBlock Grid.Row="0" Classes="metric-label" Text="Saídas do Dia"/>
              <TextBlock Grid.Row="1" Classes="metric-value"
                         Text="{Binding SaidasDia}" Foreground="#EF9A9A"/>
              <Border Grid.Row="3" CornerRadius="4" Padding="6,2"
                      Background="{Binding FundoSaidasVar}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SaidasVariacao}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding CorSaidasVar}"/>
              </Border>
              <lvc:CartesianChart Grid.Row="4"
                                  Series="{Binding SparklineSaidas}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             BARRA DE FILTROS
             ══════════════════════════════════════════════════════════ -->
        <Border Classes="sg-card" Padding="16,12">
          <Grid ColumnDefinitions="*, 12, 140, 12, 140, 12, 140, 12, Auto">

            <!-- Pesquisa livre -->
            <TextBox Grid.Column="0"
                     Classes="sg-filter"
                     Watermark="🔍  Pesquisar descrição ou conta..."
                     Text="{Binding FiltroTexto}"/>

            <!-- Tipo de lançamento -->
            <ComboBox Grid.Column="2"
                      Classes="sg-filter"
                      SelectedIndex="{Binding FiltroTipoIndex}"
                      Width="140">
              <ComboBoxItem Content="Todos os tipos"/>
              <ComboBoxItem Content="Entradas"/>
              <ComboBoxItem Content="Saídas"/>
            </ComboBox>

            <!-- Data inicial -->
            <DatePicker Grid.Column="4"
                        SelectedDate="{Binding FiltroDataInicio}"
                        FontSize="12"
                        Height="34"
                        CornerRadius="7"/>

            <!-- Data final -->
            <DatePicker Grid.Column="6"
                        SelectedDate="{Binding FiltroDataFim}"
                        FontSize="12"
                        Height="34"
                        CornerRadius="7"/>

            <!-- Botão Filtrar -->
            <Button Grid.Column="8"
                    Classes="btn-primary"
                    Command="{Binding FiltrarCommand}"
                    Padding="14,6">
              <TextBlock Text="Filtrar" FontSize="12" FontWeight="SemiBold"/>
            </Button>

          </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             TABELA DE LANÇAMENTOS
             ══════════════════════════════════════════════════════════ -->
        <Border Classes="sg-card">
          <DockPanel>

            <!-- Cabeçalho da secção -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
              <TextBlock Grid.Column="0"
                         Text="Lançamentos de Caixa"
                         Classes="section-title"
                         Margin="0"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding TotalLancamentosTexto}"
                         FontSize="11"
                         Foreground="#9AA0AB"
                         VerticalAlignment="Center"/>
            </Grid>

            <DataGrid ItemsSource="{Binding LancamentosFiltrados}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="Transparent"
                      FontSize="12"
                      MinHeight="300">

              <DataGrid.Columns>

                <!-- Data -->
                <DataGridTemplateColumn Header="Data" Width="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <TextBlock Text="{Binding Data}"
                                 VerticalAlignment="Center"
                                 Foreground="#90AECF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Tipo (pill colorida) -->
                <DataGridTemplateColumn Header="Tipo" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <StackPanel VerticalAlignment="Center" Margin="6,0">
                        <!-- Entrada -->
                        <Border Classes="pill-entrada"
                                IsVisible="{Binding IsEntrada}">
                          <TextBlock Text="Entrada"
                                     FontSize="10" FontWeight="SemiBold"
                                     Foreground="#43A047"
                                     HorizontalAlignment="Center"/>
                        </Border>
                        <!-- Saída -->
                        <Border Classes="pill-saida"
                                IsVisible="{Binding IsSaida}">
                          <TextBlock Text="Saída"
                                     FontSize="10" FontWeight="SemiBold"
                                     Foreground="#E53935"
                                     HorizontalAlignment="Center"/>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Descrição -->
                <DataGridTemplateColumn Header="Descrição" Width="2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <TextBlock Text="{Binding Descricao}"
                                 VerticalAlignment="Center"
                                 Foreground="#C8DCFF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Categoria -->
                <DataGridTemplateColumn Header="Categoria" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <TextBlock Text="{Binding Categoria}"
                                 VerticalAlignment="Center"
                                 Foreground="#90AECF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Conta -->
                <DataGridTemplateColumn Header="Conta" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <TextBlock Text="{Binding Conta}"
                                 VerticalAlignment="Center"
                                 Foreground="#90AECF"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Valor (cor consoante tipo) -->
                <DataGridTemplateColumn Header="Valor" Width="130">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <TextBlock Text="{Binding ValorFormatado}"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding CorValor}"
                                 Margin="10,0"
                                 TextAlignment="Right"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Saldo Acumulado -->
                <DataGridTemplateColumn Header="Saldo Acum." Width="130">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:LancamentoCaixaItem">
                      <TextBlock Text="{Binding SaldoAcumulado}"
                                 VerticalAlignment="Center"
                                 FontWeight="Medium"
                                 Foreground="#1A2E5A"
                                 Margin="10,0"
                                 TextAlignment="Right"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

              </DataGrid.Columns>
            </DataGrid>

          </DockPanel>
        </Border>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
