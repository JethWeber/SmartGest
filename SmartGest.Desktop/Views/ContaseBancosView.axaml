<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartGest.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="SmartGest.Desktop.Views.ContaseBancosView"
             x:DataType="vm:ContaseBancosViewModel">

  <UserControl.Styles>

    <!-- ── Card base ────────────────────────────────────────────────── -->
    <Style Selector="Border.sg-card">
      <Setter Property="CornerRadius"    Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="20"/>
      <Setter Property="BoxShadow"       Value="0 4 24 0 #28000000"/>
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#30FFFFFF"/>
          <GradientStop Offset="0.5" Color="#10FFFFFF"/>
          <GradientStop Offset="1"   Color="#05FFFFFF"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#16FFFFFF"/>
          <GradientStop Offset="1" Color="#0AFFFFFF"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- ── Item da sidebar (estado normal) ───────────────────────────── -->
    <Style Selector="Button.conta-item">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="BorderThickness"            Value="0"/>
      <Setter Property="Padding"                    Value="12,10"/>
      <Setter Property="Margin"                     Value="8,0,8,4"/>
      <Setter Property="CornerRadius"               Value="10"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.conta-item /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.conta-item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>
    <Style Selector="Button.conta-item:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>

    <!-- ── Item da sidebar (estado activo) ───────────────────────────── -->
    <Style Selector="Button.conta-item-activo">
      <Setter Property="Background"                 Value="#14FFFFFF"/>
      <Setter Property="BorderThickness"            Value="0"/>
      <Setter Property="Padding"                    Value="12,10"/>
      <Setter Property="Margin"                     Value="8,0,8,4"/>
      <Setter Property="CornerRadius"               Value="10"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.conta-item-activo /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background"   Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Button.conta-item-activo:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>

    <!-- ── Títulos de secção ─────────────────────────────────────────── -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#C8DCFF"/>
      <Setter Property="Margin"     Value="0,0,0,12"/>
      <Setter Property="LetterSpacing" Value="0.3"/>
    </Style>

    <!-- ── Labels / valores de métricas ─────────────────────────────── -->
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize"   Value="10.5"/>
      <Setter Property="Foreground" Value="#60FFFFFF"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize"   Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <!-- ── Botão primário ───────────────────────────────────────────── -->
    <Style Selector="Button.btn-primary">
      <Setter Property="Background"                 Value="#2196F3"/>
      <Setter Property="Foreground"                 Value="White"/>
      <Setter Property="FontSize"                   Value="12"/>
      <Setter Property="FontWeight"                 Value="SemiBold"/>
      <Setter Property="Padding"                    Value="16,8"/>
      <Setter Property="CornerRadius"               Value="7"/>
      <Setter Property="Cursor"                     Value="Hand"/>
      <Setter Property="BorderThickness"            Value="0"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E88E5"/>
    </Style>

    <!-- ── Botão outline ────────────────────────────────────────────── -->
    <Style Selector="Button.btn-outline">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="#E8F0FF"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="14,8"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush"     Value="#20FFFFFF"/>
    </Style>
    <Style Selector="Button.btn-outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#12FFFFFF"/>
    </Style>

    <!-- ── Botão de perigo (eliminar) ───────────────────────────────── -->
    <Style Selector="Button.btn-danger">
      <Setter Property="Background"      Value="#FFEBEE"/>
      <Setter Property="Foreground"      Value="#E53935"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="10,6"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFCDD2"/>
    </Style>

    <!-- ── Filtros ──────────────────────────────────────────────────── -->
    <Style Selector="ComboBox.sg-filter, TextBox.sg-filter">
      <Setter Property="Background"      Value="#12FFFFFF"/>
      <Setter Property="BorderBrush"     Value="#25FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="10,6"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Height"          Value="34"/>
    </Style>

    <!-- ── Campo do formulário ──────────────────────────────────────── -->
    <Style Selector="TextBox.form-field">
      <Setter Property="Background"      Value="#12FFFFFF"/>
      <Setter Property="BorderBrush"     Value="#25FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="10,8"/>
      <Setter Property="FontSize"        Value="12"/>
    </Style>

    <!-- ── Campo do formulário com erro ─────────────────────────────── -->
    <Style Selector="TextBox.form-field-error">
      <Setter Property="Background"      Value="#18E53935"/>
      <Setter Property="BorderBrush"     Value="#E53935"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="10,8"/>
      <Setter Property="FontSize"        Value="12"/>
    </Style>

    <!-- ── Linhas alternadas da DataGrid ────────────────────────────── -->
    <Style Selector="DataGridRow:nth-child(odd)">
      <Setter Property="Background" Value="#08FFFFFF"/>
    </Style>

  </UserControl.Styles>

  <!-- ════════════════════════════════════════════════════════════════════════
       RAIZ — Grid com layout principal + overlay do modal em cima
       ════════════════════════════════════════════════════════════════════════ -->
  <Grid>

    <!-- ── Layout de duas colunas ── -->
    <Grid Background="Transparent" ColumnDefinitions="300, *">

      <!-- ══════════════════════════════════════════════════════════════
           COLUNA ESQUERDA — sidebar de contas
           ══════════════════════════════════════════════════════════════ -->
      <Border Grid.Column="0" Background="#16FFFFFF" BoxShadow="2 0 12 0 #08000000">
        <DockPanel>

          <!-- Cabeçalho da sidebar -->
          <Border DockPanel.Dock="Top"
                  Padding="16,18,16,14"
                  BorderBrush="#1FFFFFFF"
                  BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">

              <StackPanel Spacing="2">
                <TextBlock Text="Contas e Bancos"
                           FontSize="15" FontWeight="Bold" Foreground="#F0F6FF"/>
                <TextBlock Text="Clique numa conta para ver o detalhe"
                           FontSize="11" Foreground="#90AECF"/>
              </StackPanel>

              <!-- Botão Gerir Contas -->
              <Button Classes="btn-primary"
                      Command="{Binding AbrirGerirContasCommand}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <mi:MaterialIcon Kind="CogOutline" Width="14" Height="14"/>
                  <TextBlock Text="Gerir Contas" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

            </StackPanel>
          </Border>

          <!-- Lista de contas -->
          <!-- Estado de carregamento -->
          <StackPanel DockPanel.Dock="Top"
                      IsVisible="{Binding IsLoading}"
                      HorizontalAlignment="Center"
                      Margin="0,20,0,0" Spacing="8">
            <mi:MaterialIcon Kind="Loading" Width="24" Height="24" Foreground="#90AECF"/>
            <TextBlock Text="A carregar..." FontSize="12" Foreground="#90AECF" HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Mensagem de erro na sidebar -->
            <Border DockPanel.Dock="Top"
              IsVisible="{Binding ErroMensagem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="#18E53935" CornerRadius="8" Padding="12,8" Margin="8,8,8,0">
            <TextBlock Text="{Binding ErroMensagem}" FontSize="11" Foreground="#E53935" TextWrapping="Wrap"/>
          </Border>

          <ScrollViewer Padding="0,8,0,8">
            <ItemsControl ItemsSource="{Binding ContasFiltradas}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContaBancariaItem">
                  <!--
                    Dois botões em Grid — apenas um visível de cada vez,
                    controlado pela propriedade IsActiva do item
                    (actualizada pelo ViewModel quando a seleção muda).
                  -->
                  <Grid>
                    <!-- Estado INACTIVO -->
                    <Button Classes="conta-item"
                            IsVisible="{Binding !IsActiva}"
                            Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).SelecionarContaCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="46, *">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{Binding CorAccent}" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Iniciais}" FontSize="12" FontWeight="Bold"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Banco}" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FF"/>
                          <TextBlock Text="{Binding Tipo}"  FontSize="11" Foreground="#90AECF"/>
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SaldoFmt}" FontSize="12" FontWeight="Bold"
                                       Foreground="#C8DCFF" VerticalAlignment="Center"/>
                            <Border Background="{Binding FundoVariacao}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding VariacaoFmt}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{Binding CorVariacao}"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Button>

                    <!-- Estado ACTIVO -->
                    <Button Classes="conta-item-activo"
                            IsVisible="{Binding IsActiva}"
                            Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).SelecionarContaCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="46, *">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{Binding CorAccent}" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Iniciais}" FontSize="12" FontWeight="Bold"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Banco}" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FF"/>
                          <TextBlock Text="{Binding Tipo}"  FontSize="11" Foreground="#90AECF"/>
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SaldoFmt}" FontSize="12" FontWeight="Bold"
                                       Foreground="#C8DCFF" VerticalAlignment="Center"/>
                            <Border Background="{Binding FundoVariacao}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding VariacaoFmt}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{Binding CorVariacao}"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Button>

                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

        </DockPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           COLUNA DIREITA — detalhe + gráfico + movimentos
           ══════════════════════════════════════════════════════════════ -->
      <ScrollViewer Grid.Column="1" Background="Transparent">
        <Border Padding="24,24"
                Background="#16FFFFFF"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                CornerRadius="24">
          <StackPanel Spacing="20">

            <!-- Cabeçalho da página -->
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0">
                <TextBlock Text="Detalhe da Conta"
                           FontSize="20" FontWeight="Bold" Foreground="#F0F6FF"/>
                <TextBlock Text="Movimentos bancários e evolução de saldo"
                           FontSize="12" Foreground="#55FFFFFF" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="btn-outline"
                      Command="{Binding ExportarCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <mi:MaterialIcon Kind="FileExcelOutline" Width="14" Height="14"/>
                  <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Cards de métricas -->
            <Grid ColumnDefinitions="*, 12, *, 12, *">

              <Border Grid.Column="0" Classes="sg-card">
                <Grid ColumnDefinitions="*, 100">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="metric-label" Text="Saldo Consolidado"/>
                    <TextBlock Classes="metric-value" Text="{Binding SaldoConsolidado}" Foreground="#64B5F6"/>
                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding SaldoVariacao}" FontSize="10" FontWeight="SemiBold" Foreground="#1A2E5A"/>
                    </Border>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Column="1" Height="50"
                                      Series="{Binding SparklineSaldo}"
                                      TooltipPosition="Hidden" Background="Transparent"/>
                </Grid>
              </Border>

              <Border Grid.Column="2" Classes="sg-card">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="metric-label" Text="Contas Activas"/>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <mi:MaterialIcon Kind="Bank" Width="28" Height="28" Foreground="#2196F3"/>
                    <TextBlock Text="{Binding TotalContas}" FontSize="32" FontWeight="Bold"
                               Foreground="#2196F3" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Classes="sg-card">
                <Grid ColumnDefinitions="*, 100">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="metric-label" Text="Movimentos (Mês)"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                      <mi:MaterialIcon Kind="SwapHorizontal" Width="28" Height="28" Foreground="#7B1FA2"/>
                      <TextBlock Text="{Binding MovimentosMes}" FontSize="32" FontWeight="Bold"
                                 Foreground="#7B1FA2" VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Column="1" Height="50"
                                      Series="{Binding SparklineMovimentos}"
                                      TooltipPosition="Hidden" Background="Transparent"/>
                </Grid>
              </Border>

            </Grid>

            <!-- Detalhe da conta seleccionada -->
            <Border Classes="sg-card"
                    IsVisible="{Binding ContaSelecionada, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="*, 20, 260">

                <StackPanel Grid.Column="0" Spacing="14">
                  <TextBlock Classes="section-title" Text="{Binding ContaSelecionada.Banco}"/>
                  <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 10, Auto, 10, Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                      <TextBlock Text="NIB" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.NIB}" FontSize="12" Foreground="#F0F6FF" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
                      <TextBlock Text="Tipo de Conta" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Tipo}" FontSize="12" Foreground="#F0F6FF" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2" Spacing="2">
                      <TextBlock Text="Agência" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Agencia}" FontSize="12" Foreground="#F0F6FF" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                      <TextBlock Text="Titular" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Titular}" FontSize="12" Foreground="#F0F6FF" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="4" Spacing="2">
                      <TextBlock Text="Moeda" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Moeda}" FontSize="12" Foreground="#F0F6FF" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="4" Spacing="2">
                      <TextBlock Text="Saldo Actual" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.SaldoFmt}" FontSize="15" FontWeight="Bold" Foreground="#64B5F6"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="Evolução de Saldo (12 meses)" Classes="metric-label"/>
                  <lvc:CartesianChart Height="120"
                                      Series="{Binding SeriesEvolucao}"
                                      XAxes="{Binding EixoX}"
                                      YAxes="{Binding EixoY}"
                                      TooltipPosition="Top"
                                      Background="Transparent"/>
                </StackPanel>

              </Grid>
            </Border>

            <!-- Filtros de movimentos -->
            <Border Classes="sg-card" Padding="16,12">
              <Grid ColumnDefinitions="*, 8, Auto, 8, *, 8, *, 8, Auto">
                <TextBox Grid.Column="0" Classes="sg-filter"
                         Watermark="Pesquisar descrição ou referência..."
                         Text="{Binding FiltroTexto}"/>
                <ComboBox Grid.Column="2" Classes="sg-filter"
                          SelectedIndex="{Binding FiltroTipoIndex}" Width="140">
                  <ComboBoxItem Content="Todos os tipos"/>
                  <ComboBoxItem Content="Créditos"/>
                  <ComboBoxItem Content="Débitos"/>
                </ComboBox>
                <DatePicker Grid.Column="4" SelectedDate="{Binding FiltroDataInicio}"
                            FontSize="12" Height="34" CornerRadius="7"/>
                <DatePicker Grid.Column="6" SelectedDate="{Binding FiltroDataFim}"
                            FontSize="12" Height="34" CornerRadius="7"/>
                <Button Grid.Column="8" Classes="btn-primary"
                        Command="{Binding FiltrarCommand}" Padding="14,6">
                  <TextBlock Text="Filtrar" FontSize="12" FontWeight="SemiBold"/>
                </Button>
              </Grid>
            </Border>

            <!-- Tabela de movimentos -->
            <Border Classes="sg-card">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                  <TextBlock Grid.Column="0" Text="Movimentos Bancários" Classes="section-title" Margin="0"/>
                  <TextBlock Grid.Column="1" Text="{Binding TotalMovimentosTexto}"
                             FontSize="11" Foreground="#90AECF" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid ItemsSource="{Binding MovimentosFiltrados}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowBackground="Transparent" FontSize="12" MinHeight="280">
                  <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Data" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Data}" VerticalAlignment="Center" Foreground="#90AECF" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Banco" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Banco}" VerticalAlignment="Center"
                                     Foreground="#C8DCFF" FontWeight="Medium" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Referência" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Referencia}" VerticalAlignment="Center"
                                     Foreground="#90AECF" FontSize="11" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Descrição" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Descricao}" VerticalAlignment="Center"
                                     Foreground="#C8DCFF" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tipo" Width="90">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <Border Background="{Binding FundoPill}" CornerRadius="10" Padding="8,2"
                                  Margin="6,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Tipo}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding CorPill}"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Valor (Kzs)" Width="140">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding ValorFmt}" VerticalAlignment="Center"
                                     TextAlignment="Right" FontWeight="SemiBold"
                                     Foreground="{Binding CorValor}" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

          </StackPanel>
        </Border>
      </ScrollViewer>

    </Grid>

    <!-- ════════════════════════════════════════════════════════════════════
         OVERLAY + MODAL "GERIR CONTAS"
         Visível apenas quando ModalGerirAberto = true.
         ════════════════════════════════════════════════════════════════════ -->
    <!-- Panel + ZIndex: o backdrop não pode ficar por cima do formulário (bloqueava cliques) -->
    <Panel IsVisible="{Binding ModalGerirAberto}">

      <!-- Fundo semi-transparente — ZIndex 0, atrás do modal -->
      <Button ZIndex="0"
              Background="#80000000"
              BorderThickness="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Command="{Binding FecharModalCommand}"/>

      <!-- Caixa do modal centrada — ZIndex 1, recebe cliques -->
      <Border ZIndex="1"
              CornerRadius="14"
              BoxShadow="0 12 40 0 #60000000"
              Width="940"
              MaxHeight="700"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="0"
              ClipToBounds="True"
              BorderThickness="1">

        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1A2947" Offset="0"/>
            <GradientStop Color="#0F1830" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0"   Color="#30FFFFFF"/>
            <GradientStop Offset="0.5" Color="#10FFFFFF"/>
            <GradientStop Offset="1"   Color="#05FFFFFF"/>
          </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid RowDefinitions="Auto, *, Auto">

          <!-- ── Cabeçalho do modal ── -->
          <Border Grid.Row="0"
                  Padding="28,20"
                  BorderBrush="#1FFFFFFF"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Gerir Contas Bancárias"
                           FontSize="17" FontWeight="Bold" Foreground="#F0F6FF"/>
                <TextBlock Text="Adicione, edite ou elimine contas bancárias"
                           FontSize="12" Foreground="#55FFFFFF"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Background="Transparent" BorderThickness="0"
                      Padding="8" CornerRadius="8" Cursor="Hand"
                      Command="{Binding FecharModalCommand}"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="#90AECF"/>
              </Button>
            </Grid>
          </Border>

          <!-- ── Corpo: lista à esquerda + formulário à direita ── -->
          <Grid Grid.Row="1" ColumnDefinitions="*, 1, 340">

            <!-- Lista de contas no modal -->
            <DockPanel Grid.Column="0">

              <Border DockPanel.Dock="Top"
                      Padding="20,14,20,12"
                      BorderBrush="#1AFFFFFF"
                      BorderThickness="0,0,0,1">
                <TextBlock Text="Contas existentes"
                           FontSize="12" FontWeight="SemiBold" Foreground="#C8DCFF"/>
              </Border>

              <ScrollViewer Padding="16,8">
                <ItemsControl ItemsSource="{Binding ContasEditaveis}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContaBancariaEditavel">
                      <Border Background="#12FFFFFF" CornerRadius="10"
                              Padding="14,12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="40, *, Auto, 8, Auto">

                          <!-- Avatar -->
                          <Border Grid.Column="0"
                                  Width="34" Height="34" CornerRadius="17"
                                  Background="{Binding CorAccent}"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Iniciais}"
                                       FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>

                          <!-- Info -->
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Banco}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FF"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Tipo}"      FontSize="11" Foreground="#90AECF"/>
                              <TextBlock Text="·"                   FontSize="11" Foreground="#90AECF"/>
                              <TextBlock Text="{Binding SaldoFmt}"  FontSize="11" Foreground="#C8DCFF" FontWeight="Medium"/>
                            </StackPanel>
                          </StackPanel>

                          <!-- Editar -->
                          <Button Grid.Column="2" Classes="btn-outline"
                                  Padding="10,5" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).EditarContaModalCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12"/>
                              <TextBlock Text="Editar" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>

                          <!-- Eliminar -->
                          <Button Grid.Column="4" Classes="btn-danger"
                                  Padding="8,5" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).EliminarContaModalCommand}"
                                  CommandParameter="{Binding}">
                            <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/>
                          </Button>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

            </DockPanel>

            <!-- Divisor vertical -->
            <Border Grid.Column="1" Background="#1FFFFFFF"/>

            <!-- Formulário Nova / Editar conta -->
            <DockPanel Grid.Column="2">

              <Border DockPanel.Dock="Top"
                      Padding="20,14,20,12"
                      BorderBrush="#1AFFFFFF"
                      BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding FormTitulo}"
                           FontSize="12" FontWeight="SemiBold" Foreground="#C8DCFF"/>
              </Border>

              <!-- Erro global do modal (ex: NIB duplicado, erro de rede) -->
              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding ErroModal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="#FFEBEE" CornerRadius="8" Padding="12,8" Margin="20,8,20,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#E53935"/>
                  <TextBlock Text="{Binding ErroModal}" FontSize="11" Foreground="#E53935" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- Sucesso global do modal -->
              <Border DockPanel.Dock="Top"
                      IsVisible="{Binding SucessoModal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="20,8,20,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="CheckCircleOutline" Width="14" Height="14" Foreground="#2E7D32"/>
                  <TextBlock Text="{Binding SucessoModal}" FontSize="11" Foreground="#1B5E20" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <ScrollViewer Padding="20,16">
                <StackPanel Spacing="14">

                  <!-- Nome do Banco -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Nome do Banco *" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="Ex: Banco BIC"
                             Text="{Binding FormBanco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding FormErroBanco}" FontSize="10" Foreground="#E53935"
                               IsVisible="{Binding FormErroBanco, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- NIB -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="NIB *" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="AO06.0000.0000.…"
                             Text="{Binding FormNIB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding FormErroNIB}" FontSize="10" Foreground="#E53935"
                               IsVisible="{Binding FormErroNIB, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- Titular -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Titular *" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="Ex: SmartGest, Lda."
                             Text="{Binding FormTitular, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding FormErroTitular}" FontSize="10" Foreground="#E53935"
                               IsVisible="{Binding FormErroTitular, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- Tipo de Conta -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Tipo de Conta" Classes="metric-label"/>
                    <!--
                      Em Avalonia, SelectedItem com string simples não funciona quando os itens
                      são ComboBoxItem. Usamos SelectedIndex mapeado por propriedade no VM,
                      ou — solução mais simples — ItemsSource com lista de strings.
                    -->
                    <ComboBox ItemsSource="{Binding TiposConta}"
                              SelectedItem="{Binding FormTipo}"
                              HorizontalAlignment="Stretch" FontSize="12"/>
                  </StackPanel>

                  <!-- Moeda -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Moeda" Classes="metric-label"/>
                    <ComboBox ItemsSource="{Binding MoedasDisponiveis}"
                              SelectedItem="{Binding FormMoeda}"
                              HorizontalAlignment="Stretch" FontSize="12"/>
                  </StackPanel>

                  <!-- Agência -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Agência" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="Ex: Luanda — Maianga"
                             Text="{Binding FormAgencia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>

                  <!-- Saldo Inicial -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Saldo Inicial (Kzs)" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="0"
                             Text="{Binding FormSaldoTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding FormErroSaldo}" FontSize="10" Foreground="#E53935"
                               IsVisible="{Binding FormErroSaldo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <!-- Cor de Destaque -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Cor de Destaque (hex)" Classes="metric-label"/>
                    <Grid ColumnDefinitions="*, 10, 36">
                      <TextBox Grid.Column="0" Classes="form-field" Watermark="#1A2E5A"
                               Text="{Binding FormCorAccent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                      <!-- Pré-visualização da cor -->
                      <Border Grid.Column="2" Width="36" Height="36" CornerRadius="8"
                              Background="{Binding FormCorAccent}"/>
                    </Grid>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>

            </DockPanel>

          </Grid>

          <!-- ── Rodapé do modal — acções sempre visíveis ── -->
          <Border Grid.Row="2"
                  Padding="24,14"
                  BorderBrush="#1FFFFFFF"
                  BorderThickness="0,1,0,0"
                  Background="#10FFFFFF">
            <Grid ColumnDefinitions="*, Auto">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="11" Foreground="#90AECF"
                         Text="* Campos obrigatórios"/>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal" Spacing="10"
                          HorizontalAlignment="Right">
                <Button Classes="btn-outline" MinWidth="110"
                        Command="{Binding FecharModalCommand}">
                  <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold"/>
                </Button>
                <Button Classes="btn-outline" MinWidth="110"
                        Command="{Binding LimparFormularioCommand}">
                  <TextBlock Text="Limpar" FontSize="12" FontWeight="SemiBold"/>
                </Button>
                <Button Classes="btn-primary" MinWidth="150"
                        IsEnabled="{Binding !IsSaving}"
                        Command="{Binding GuardarContaCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="Loading" Width="14" Height="14"
                                     IsVisible="{Binding IsSaving}"/>
                    <mi:MaterialIcon Kind="Plus" Width="14" Height="14"
                                     IsVisible="{Binding !FormEdicaoActiva}"/>
                    <mi:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14"
                                     IsVisible="{Binding FormEdicaoActiva}"/>
                    <TextBlock Text="{Binding FormBotaoTexto}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

        </Grid>
      </Border>

    </Panel>

  </Grid>
</UserControl>