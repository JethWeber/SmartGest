<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartGest.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="SmartGest.Desktop.Views.ContaseBancosView"
             x:DataType="vm:ContaseBancosViewModel">

  <UserControl.Styles>

    <!-- ── Card base ────────────────────────────────────────────────── -->
    <Style Selector="Border.sg-card">
      <Setter Property="Background"   Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding"      Value="20,16"/>
      <Setter Property="BoxShadow"    Value="0 2 12 0 #0A000000"/>
    </Style>

    <!-- ── Item da sidebar ─────────────────────────────────────────────
         Um único Button sem Border separado elimina a discrepância de
         hit-area. O template do ContentPresenter recebe o CornerRadius
         para que o hover/press preencha exactamente o mesmo espaço.   -->
    <Style Selector="Button.conta-item">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="BorderThickness"            Value="0"/>
      <Setter Property="Padding"                    Value="12,10"/>
      <Setter Property="Margin"                     Value="8,0,8,4"/>
      <Setter Property="CornerRadius"               Value="10"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.conta-item /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.conta-item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F4FF"/>
    </Style>
    <Style Selector="Button.conta-item:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#E3EBFF"/>
    </Style>

    <!-- ── Item activo (conta seleccionada) ─────────────────────────── -->
    <Style Selector="Button.conta-item-activo">
      <Setter Property="Background"                 Value="#EEF2FF"/>
      <Setter Property="BorderThickness"            Value="0"/>
      <Setter Property="Padding"                    Value="12,10"/>
      <Setter Property="Margin"                     Value="8,0,8,4"/>
      <Setter Property="CornerRadius"               Value="10"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.conta-item-activo /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background"   Value="#EEF2FF"/>
    </Style>
    <Style Selector="Button.conta-item-activo:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E3EBFF"/>
    </Style>

    <!-- ── Títulos de secção ─────────────────────────────────────────── -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1A2E5A"/>
      <Setter Property="Margin"     Value="0,0,0,12"/>
    </Style>

    <!-- ── Labels / valores de métricas ─────────────────────────────── -->
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="Foreground" Value="#9AA0AB"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize"   Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <!-- ── Botão primário ───────────────────────────────────────────── -->
    <Style Selector="Button.btn-primary">
      <Setter Property="Background"                 Value="#2196F3"/>
      <Setter Property="Foreground"                 Value="White"/>
      <Setter Property="FontSize"                   Value="12"/>
      <Setter Property="FontWeight"                 Value="SemiBold"/>
      <Setter Property="Padding"                    Value="16,8"/>
      <Setter Property="CornerRadius"               Value="7"/>
      <Setter Property="Cursor"                     Value="Hand"/>
      <Setter Property="BorderThickness"            Value="0"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E88E5"/>
    </Style>

    <!-- ── Botão outline ────────────────────────────────────────────── -->
    <Style Selector="Button.btn-outline">
      <Setter Property="Background"      Value="White"/>
      <Setter Property="Foreground"      Value="#1A2E5A"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="14,8"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush"     Value="#DDE3EE"/>
    </Style>
    <Style Selector="Button.btn-outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F4F6FA"/>
    </Style>

    <!-- ── Botão de perigo (eliminar) ───────────────────────────────── -->
    <Style Selector="Button.btn-danger">
      <Setter Property="Background"      Value="#FFEBEE"/>
      <Setter Property="Foreground"      Value="#E53935"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="10,6"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFCDD2"/>
    </Style>

    <!-- ── Filtros ──────────────────────────────────────────────────── -->
    <Style Selector="ComboBox.sg-filter, TextBox.sg-filter">
      <Setter Property="Background"      Value="White"/>
      <Setter Property="BorderBrush"     Value="#E0E4EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="10,6"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Height"          Value="34"/>
    </Style>

    <!-- ── Campo do formulário ──────────────────────────────────────── -->
    <Style Selector="TextBox.form-field">
      <Setter Property="Background"      Value="#F8F9FC"/>
      <Setter Property="BorderBrush"     Value="#E0E4EA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="7"/>
      <Setter Property="Padding"         Value="10,8"/>
      <Setter Property="FontSize"        Value="12"/>
    </Style>

    <!-- ── Linhas alternadas da DataGrid ────────────────────────────── -->
    <Style Selector="DataGridRow:nth-child(odd)">
      <Setter Property="Background" Value="#F9FAFC"/>
    </Style>

  </UserControl.Styles>

  <!-- ════════════════════════════════════════════════════════════════════════
       RAIZ — Grid com layout principal + overlay do modal em cima
       ════════════════════════════════════════════════════════════════════════ -->
  <Grid>

    <!-- ── Layout de duas colunas ── -->
    <Grid Background="#F4F6FA" ColumnDefinitions="300, *">

      <!-- ══════════════════════════════════════════════════════════════
           COLUNA ESQUERDA — sidebar de contas
           ══════════════════════════════════════════════════════════════ -->
      <Border Grid.Column="0" Background="White" BoxShadow="2 0 12 0 #08000000">
        <DockPanel>

          <!-- Cabeçalho da sidebar -->
          <Border DockPanel.Dock="Top"
                  Padding="16,18,16,14"
                  BorderBrush="#F0F0F0"
                  BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">

              <StackPanel Spacing="2">
                <TextBlock Text="Contas e Bancos"
                           FontSize="15" FontWeight="Bold" Foreground="#1A2E5A"/>
                <TextBlock Text="Clique numa conta para ver o detalhe"
                           FontSize="11" Foreground="#9AA0AB"/>
              </StackPanel>

              <!-- Botão Gerir Contas -->
              <Button Classes="btn-primary"
                      Command="{Binding AbrirGerirContasCommand}"
                      HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <mi:MaterialIcon Kind="CogOutline" Width="14" Height="14"/>
                  <TextBlock Text="Gerir Contas" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

            </StackPanel>
          </Border>

          <!-- Lista de contas -->
          <ScrollViewer Padding="0,8,0,8">
            <ItemsControl ItemsSource="{Binding ContasFiltradas}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContaBancariaItem">
                  <!--
                    Usamos um único Button (sem Border exterior separado).
                    A classe é escolhida por MultiBinding com o converter
                    IsActive que vive no ViewModel — alternativa simples:
                    dois Buttons com IsVisible. Aqui optamos pelos dois
                    Buttons sobrepostos num Grid para evitar converters.
                  -->
                  <Grid>
                    <!-- Estado inactivo -->
                    <Button Classes="conta-item"
                            IsVisible="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).ContaSelecionada,
                                        Converter={x:Static ObjectConverters.IsNull}}"
                            Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).SelecionarContaCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="46, *">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{Binding CorAccent}" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Iniciais}" FontSize="12" FontWeight="Bold"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Banco}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2E5A"/>
                          <TextBlock Text="{Binding Tipo}"  FontSize="11" Foreground="#9AA0AB"/>
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SaldoFmt}" FontSize="12" FontWeight="Bold"
                                       Foreground="#1A2E5A" VerticalAlignment="Center"/>
                            <Border Background="{Binding FundoVariacao}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding VariacaoFmt}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{Binding CorVariacao}"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Button>

                    <!-- Estado activo / inactivo — usamos DataTrigger via Classes dinâmicas.
                         Como Avalonia não tem MultiBinding simples para classes, a solução mais
                         robusta é emitir sempre os dois botões e controlar visibilidade via
                         comparação de referência no ViewModel através de uma propriedade calculada.
                         Por ora ambos os botões disparam o mesmo comando; o estilo activo é
                         aplicado quando o item É a ContaSelecionada. -->
                    <Button Classes="conta-item-activo"
                            IsVisible="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).ContaSelecionada,
                                        Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).SelecionarContaCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="46, *">
                        <!-- Barra de acento à esquerda -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{Binding CorAccent}" VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Iniciais}" FontSize="12" FontWeight="Bold"
                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Banco}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2E5A"/>
                          <TextBlock Text="{Binding Tipo}"  FontSize="11" Foreground="#9AA0AB"/>
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SaldoFmt}" FontSize="12" FontWeight="Bold"
                                       Foreground="#1A2E5A" VerticalAlignment="Center"/>
                            <Border Background="{Binding FundoVariacao}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding VariacaoFmt}" FontSize="10" FontWeight="SemiBold"
                                         Foreground="{Binding CorVariacao}"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Button>

                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

        </DockPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           COLUNA DIREITA — detalhe + gráfico + movimentos
           ══════════════════════════════════════════════════════════════ -->
      <ScrollViewer Grid.Column="1" Background="#F4F6FA">
        <Border Padding="24,24">
          <StackPanel Spacing="20">

            <!-- Cabeçalho da página -->
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0">
                <TextBlock Text="Detalhe da Conta"
                           FontSize="20" FontWeight="Bold" Foreground="#1A2E5A"/>
                <TextBlock Text="Movimentos bancários e evolução de saldo"
                           FontSize="12" Foreground="#9AA0AB" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="btn-outline"
                      Command="{Binding ExportarCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <mi:MaterialIcon Kind="FileExcelOutline" Width="14" Height="14"/>
                  <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Cards de métricas -->
            <Grid ColumnDefinitions="*, 12, *, 12, *">

              <Border Grid.Column="0" Classes="sg-card">
                <Grid ColumnDefinitions="*, 100">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="metric-label" Text="Saldo Consolidado"/>
                    <TextBlock Classes="metric-value" Text="{Binding SaldoConsolidado}" Foreground="#1A2E5A"/>
                    <Border Background="#E3F2FD" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding SaldoVariacao}" FontSize="10" FontWeight="SemiBold" Foreground="#1A2E5A"/>
                    </Border>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Column="1" Height="50"
                                      Series="{Binding SparklineSaldo}"
                                      TooltipPosition="Hidden" Background="Transparent"/>
                </Grid>
              </Border>

              <Border Grid.Column="2" Classes="sg-card">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="metric-label" Text="Contas Activas"/>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <mi:MaterialIcon Kind="Bank" Width="28" Height="28" Foreground="#2196F3"/>
                    <TextBlock Text="{Binding TotalContas}" FontSize="32" FontWeight="Bold"
                               Foreground="#2196F3" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Classes="sg-card">
                <Grid ColumnDefinitions="*, 100">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="metric-label" Text="Movimentos (Mês)"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                      <mi:MaterialIcon Kind="SwapHorizontal" Width="28" Height="28" Foreground="#7B1FA2"/>
                      <TextBlock Text="{Binding MovimentosMes}" FontSize="32" FontWeight="Bold"
                                 Foreground="#7B1FA2" VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Column="1" Height="50"
                                      Series="{Binding SparklineMovimentos}"
                                      TooltipPosition="Hidden" Background="Transparent"/>
                </Grid>
              </Border>

            </Grid>

            <!-- Detalhe da conta seleccionada -->
            <Border Classes="sg-card"
                    IsVisible="{Binding ContaSelecionada, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="*, 20, 260">

                <StackPanel Grid.Column="0" Spacing="14">
                  <TextBlock Classes="section-title" Text="{Binding ContaSelecionada.Banco}"/>
                  <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 10, Auto, 10, Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                      <TextBlock Text="NIB" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.NIB}" FontSize="12" Foreground="#333333" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
                      <TextBlock Text="Tipo de Conta" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Tipo}" FontSize="12" Foreground="#333333" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2" Spacing="2">
                      <TextBlock Text="Agência" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Agencia}" FontSize="12" Foreground="#333333" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                      <TextBlock Text="Titular" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Titular}" FontSize="12" Foreground="#333333" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="4" Spacing="2">
                      <TextBlock Text="Moeda" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.Moeda}" FontSize="12" Foreground="#333333" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="4" Spacing="2">
                      <TextBlock Text="Saldo Actual" Classes="metric-label"/>
                      <TextBlock Text="{Binding ContaSelecionada.SaldoFmt}" FontSize="15" FontWeight="Bold" Foreground="#1A2E5A"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="Evolução de Saldo (12 meses)" Classes="metric-label"/>
                  <lvc:CartesianChart Height="120"
                                      Series="{Binding SeriesEvolucao}"
                                      XAxes="{Binding EixoX}"
                                      YAxes="{Binding EixoY}"
                                      TooltipPosition="Top"
                                      Background="Transparent"/>
                </StackPanel>

              </Grid>
            </Border>

            <!-- Filtros de movimentos -->
            <Border Classes="sg-card" Padding="16,12">
              <Grid ColumnDefinitions="*, 8, Auto, 8, *, 8, *, 8, Auto">
                <TextBox Grid.Column="0" Classes="sg-filter"
                         Watermark="Pesquisar descrição ou referência..."
                         Text="{Binding FiltroTexto}"/>
                <ComboBox Grid.Column="2" Classes="sg-filter"
                          SelectedIndex="{Binding FiltroTipoIndex}" Width="140">
                  <ComboBoxItem Content="Todos os tipos"/>
                  <ComboBoxItem Content="Créditos"/>
                  <ComboBoxItem Content="Débitos"/>
                </ComboBox>
                <DatePicker Grid.Column="4" SelectedDate="{Binding FiltroDataInicio}"
                            FontSize="12" Height="34" CornerRadius="7"/>
                <DatePicker Grid.Column="6" SelectedDate="{Binding FiltroDataFim}"
                            FontSize="12" Height="34" CornerRadius="7"/>
                <Button Grid.Column="8" Classes="btn-primary"
                        Command="{Binding FiltrarCommand}" Padding="14,6">
                  <TextBlock Text="Filtrar" FontSize="12" FontWeight="SemiBold"/>
                </Button>
              </Grid>
            </Border>

            <!-- Tabela de movimentos -->
            <Border Classes="sg-card">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                  <TextBlock Grid.Column="0" Text="Movimentos Bancários" Classes="section-title" Margin="0"/>
                  <TextBlock Grid.Column="1" Text="{Binding TotalMovimentosTexto}"
                             FontSize="11" Foreground="#9AA0AB" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid ItemsSource="{Binding MovimentosFiltrados}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowBackground="Transparent" FontSize="12" MinHeight="280">
                  <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Data" Width="100">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Data}" VerticalAlignment="Center" Foreground="#555555" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Banco" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Banco}" VerticalAlignment="Center"
                                     Foreground="#333333" FontWeight="Medium" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Referência" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Referencia}" VerticalAlignment="Center"
                                     Foreground="#9AA0AB" FontSize="11" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Descrição" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding Descricao}" VerticalAlignment="Center"
                                     Foreground="#333333" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tipo" Width="90">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <Border Background="{Binding FundoPill}" CornerRadius="10" Padding="8,2"
                                  Margin="6,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Tipo}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding CorPill}"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Valor (Kzs)" Width="140">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MovimentoBancarioItem">
                          <TextBlock Text="{Binding ValorFmt}" VerticalAlignment="Center"
                                     TextAlignment="Right" FontWeight="SemiBold"
                                     Foreground="{Binding CorValor}" Margin="10,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

          </StackPanel>
        </Border>
      </ScrollViewer>

    </Grid>

    <!-- ════════════════════════════════════════════════════════════════════
         OVERLAY + MODAL "GERIR CONTAS"
         Visível apenas quando ModalGerirAberto = true.
         O rodapé fica dentro do RowDefinitions do modal — sem Margin fixo.
         ════════════════════════════════════════════════════════════════════ -->
    <Grid IsVisible="{Binding ModalGerirAberto}">

      <!-- Fundo semi-transparente: clicar fora fecha -->
      <Border Background="#80000000">
        <Button Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding FecharModalCommand}"/>
      </Border>

      <!-- Caixa do modal centrada -->
      <Border Background="White"
              CornerRadius="14"
              BoxShadow="0 8 40 0 #28000000"
              Width="940"
              MaxHeight="700"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="0"
              ClipToBounds="True">

        <Grid RowDefinitions="Auto, *, Auto">

          <!-- ── Cabeçalho do modal ── -->
          <Border Grid.Row="0"
                  Padding="28,20"
                  BorderBrush="#F0F0F0"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Gerir Contas Bancárias"
                           FontSize="17" FontWeight="Bold" Foreground="#1A2E5A"/>
                <TextBlock Text="Adicione, edite ou elimine contas bancárias"
                           FontSize="12" Foreground="#9AA0AB"/>
              </StackPanel>
              <!-- Botão X fechar -->
              <Button Grid.Column="1"
                      Background="Transparent" BorderThickness="0"
                      Padding="8" CornerRadius="8" Cursor="Hand"
                      Command="{Binding FecharModalCommand}"
                      VerticalAlignment="Center">
                <mi:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="#9AA0AB"/>
              </Button>
            </Grid>
          </Border>

          <!-- ── Corpo: lista à esquerda + formulário à direita ── -->
          <Grid Grid.Row="1" ColumnDefinitions="*, 1, 320">

            <!-- Lista de contas no modal -->
            <DockPanel Grid.Column="0">

              <Border DockPanel.Dock="Top"
                      Padding="20,14,20,12"
                      BorderBrush="#F5F5F5"
                      BorderThickness="0,0,0,1">
                <TextBlock Text="Contas existentes"
                           FontSize="12" FontWeight="SemiBold" Foreground="#1A2E5A"/>
              </Border>

              <ScrollViewer Padding="16,8">
                <ItemsControl ItemsSource="{Binding ContasEditaveis}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContaBancariaEditavel">
                      <Border Background="#F8F9FC" CornerRadius="10"
                              Padding="14,12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="40, *, Auto, 8, Auto">

                          <!-- Avatar -->
                          <Border Grid.Column="0"
                                  Width="34" Height="34" CornerRadius="17"
                                  Background="{Binding CorAccent}"
                                  VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Iniciais}"
                                       FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>

                          <!-- Info -->
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Banco}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#1A2E5A"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Tipo}"      FontSize="11" Foreground="#9AA0AB"/>
                              <TextBlock Text="·"                   FontSize="11" Foreground="#9AA0AB"/>
                              <TextBlock Text="{Binding SaldoFmt}"  FontSize="11" Foreground="#555555" FontWeight="Medium"/>
                            </StackPanel>
                          </StackPanel>

                          <!-- Editar -->
                          <Button Grid.Column="2" Classes="btn-outline"
                                  Padding="10,5" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).EditarContaModalCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12"/>
                              <TextBlock Text="Editar" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>

                          <!-- Eliminar -->
                          <Button Grid.Column="4" Classes="btn-danger"
                                  Padding="8,5" VerticalAlignment="Center"
                                  Command="{Binding $parent[UserControl].((vm:ContaseBancosViewModel)DataContext).EliminarContaModalCommand}"
                                  CommandParameter="{Binding}">
                            <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/>
                          </Button>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

            </DockPanel>

            <!-- Divisor vertical -->
            <Border Grid.Column="1" Background="#F0F0F0"/>

            <!-- Formulário Nova / Editar conta -->
            <DockPanel Grid.Column="2">

              <Border DockPanel.Dock="Top"
                      Padding="20,14,20,12"
                      BorderBrush="#F5F5F5"
                      BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding FormTitulo}"
                           FontSize="12" FontWeight="SemiBold" Foreground="#1A2E5A"/>
              </Border>

              <ScrollViewer Padding="20,16">
                <StackPanel Spacing="14">

                  <StackPanel Spacing="4">
                    <TextBlock Text="Nome do Banco *" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="Ex: Banco BIC" Text="{Binding FormBanco}"/>
                    <TextBlock Text="{Binding FormErroBanco}" FontSize="10" Foreground="#E53935"
                               IsVisible="{Binding FormErroBanco, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="NIB *" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="AO06.0000.0000.…" Text="{Binding FormNIB}"/>
                    <TextBlock Text="{Binding FormErroNIB}" FontSize="10" Foreground="#E53935"
                               IsVisible="{Binding FormErroNIB, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Tipo de Conta" Classes="metric-label"/>
                    <ComboBox SelectedItem="{Binding FormTipo}" HorizontalAlignment="Stretch" FontSize="12">
                      <ComboBoxItem Content="Conta à Ordem"/>
                      <ComboBoxItem Content="Depósito a Prazo"/>
                      <ComboBoxItem Content="Conta Poupança"/>
                      <ComboBoxItem Content="Conta Empresarial"/>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Moeda" Classes="metric-label"/>
                    <ComboBox SelectedItem="{Binding FormMoeda}" HorizontalAlignment="Stretch" FontSize="12">
                      <ComboBoxItem Content="AOA"/>
                      <ComboBoxItem Content="USD"/>
                      <ComboBoxItem Content="EUR"/>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Agência" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="Ex: Luanda — Maianga" Text="{Binding FormAgencia}"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Titular" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="Ex: SmartGest, Lda." Text="{Binding FormTitular}"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Saldo Inicial (Kzs)" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="0" Text="{Binding FormSaldo}"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Cor de Destaque (hex)" Classes="metric-label"/>
                    <TextBox Classes="form-field" Watermark="#1A2E5A" Text="{Binding FormCorAccent}"/>
                  </StackPanel>

                  <!-- Limpar / Guardar -->
                  <Grid ColumnDefinitions="*, 8, *" Margin="0,4,0,0">
                    <Button Grid.Column="0" Classes="btn-outline"
                            HorizontalAlignment="Stretch"
                            Command="{Binding LimparFormularioCommand}">
                      <TextBlock Text="Limpar" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="2" Classes="btn-primary"
                            HorizontalAlignment="Stretch"
                            Command="{Binding GuardarContaCommand}">
                      <TextBlock Text="{Binding FormBotaoTexto}"
                                 FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                  </Grid>

                </StackPanel>
              </ScrollViewer>

            </DockPanel>

          </Grid>

          <!-- ── Rodapé do modal (dentro do RowDefinitions — sem Margin fixo) ── -->
          <Border Grid.Row="2"
                  Padding="24,14"
                  BorderBrush="#F0F0F0"
                  BorderThickness="0,1,0,0"
                  Background="White">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="btn-outline" Width="130"
                      Command="{Binding FecharModalCommand}">
                <TextBlock Text="Cancelar" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              </Button>
              <Button Classes="btn-primary" Width="170"
                      Command="{Binding AplicarAlteracoesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <mi:MaterialIcon Kind="Check" Width="14" Height="14"/>
                  <TextBlock Text="Aplicar Alterações" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

    </Grid>

  </Grid>
</UserControl>