<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartGest.Desktop.ViewModels"
        x:Class="SmartGest.Desktop.Views.SplashView"
        x:DataType="vm:SplashViewModel"
        Title="SmartGest"
        Width="480" Height="320"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="False"
        TransparencyLevelHint="AcrylicBlur,Transparent">

  <Window.Styles>

    <!-- ProgressBar Glassmorphism -->
    <Style Selector="ProgressBar.sg-progress">
      <Setter Property="Height" Value="5"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="#28FFFFFF"/>
      <Setter Property="Foreground" Value="#2196F3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
    </Style>

    <!-- Override da barra de fill para gradiente azul -->
    <Style Selector="ProgressBar.sg-progress /template/ Border#PART_Indicator">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="#1565C0"/>
          <GradientStop Offset="1" Color="#42A5F5"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>

  </Window.Styles>

  <!-- Fundo gradiente escuro — camada de trás -->
  <Panel>

    <!-- Gradient background -->
    <Border CornerRadius="18" ClipToBounds="True">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#0D1B2E"/>
          <GradientStop Offset="0.5" Color="#0A1628"/>
          <GradientStop Offset="1"   Color="#061020"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- Orbe de luz azul — canto superior direito -->
    <Ellipse Width="280" Height="280"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="0,-80,-80,0"
             Opacity="0.18">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#2196F3"/>
          <GradientStop Offset="1" Color="Transparent"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- Orbe de luz azul — canto inferior esquerdo -->
    <Ellipse Width="220" Height="220"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom"
             Margin="-60,0,0,-60"
             Opacity="0.12">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#1565C0"/>
          <GradientStop Offset="1" Color="Transparent"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- Painel de vidro principal (Glassmorphism) -->
    <Border CornerRadius="18"
            ClipToBounds="True"
            BorderThickness="1"
            Margin="1"
            BoxShadow="0 8 48 0 #50000000, 0 1 0 0 #30FFFFFF inset">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#40FFFFFF"/>
          <GradientStop Offset="0.5" Color="#10FFFFFF"/>
          <GradientStop Offset="1"   Color="#08FFFFFF"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0"   Color="#1AFFFFFF"/>
          <GradientStop Offset="1"   Color="#08FFFFFF"/>
        </LinearGradientBrush>
      </Border.Background>

      <Grid RowDefinitions="*,Auto">

        <!-- ===== ÁREA CENTRAL ===== -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="0"
                    Margin="48,40,48,0">

          <!-- Logo do sistema -->
          <Image Source="/Assets/smartgest_logo_white.png"
                 Width="240"
                 HorizontalAlignment="Center"
                 Stretch="Uniform"
                 Margin="0,0,0,32"/>

          <!-- Linha separadora glass -->
          <Border Height="1"
                  Margin="0,0,0,20"
                  HorizontalAlignment="Stretch"
                  Opacity="0.25">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Offset="0"   Color="Transparent"/>
                <GradientStop Offset="0.5" Color="#2196F3"/>
                <GradientStop Offset="1"   Color="Transparent"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <!-- Status text -->
          <TextBlock Text="{Binding StatusText}"
                     FontSize="11"
                     Foreground="#80FFFFFF"
                     HorizontalAlignment="Center"
                     LetterSpacing="1.5"
                     Margin="0,0,0,12"/>

          <!-- ProgressBar linear -->
          <ProgressBar Classes="sg-progress"
                       Value="{Binding ProgressValue}"
                       HorizontalAlignment="Stretch"/>

          <!-- Percentagem -->
          <TextBlock Text="{Binding ProgressText}"
                     FontSize="10"
                     Foreground="#50FFFFFF"
                     HorizontalAlignment="Right"
                     Margin="0,6,0,0"/>

        </StackPanel>

        <!-- ===== RODAPÉ ===== -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,14"
                Margin="24,0,24,0">
          <Border.BorderBrush>
            <SolidColorBrush Color="#15FFFFFF"/>
          </Border.BorderBrush>
          <TextBlock Text="EducaEmpreende · Luanda, Angola"
                     FontSize="9.5"
                     Foreground="#40FFFFFF"
                     HorizontalAlignment="Center"
                     LetterSpacing="1"/>
        </Border>

      </Grid>
    </Border>

  </Panel>
</Window>
