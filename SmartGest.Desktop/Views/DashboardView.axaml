<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartGest.Desktop.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="SmartGest.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Styles>

    <!-- Card base -->
    <Style Selector="Border.sg-card">
      <Setter Property="Background"    Value="White"/>
      <Setter Property="CornerRadius"  Value="10"/>
      <Setter Property="Padding"       Value="20,16"/>
      <Setter Property="BoxShadow"     Value="0 2 12 0 #0A000000"/>
    </Style>

    <!-- Cabeçalho da secção -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Foreground"   Value="#1A2E5A"/>
      <Setter Property="Margin"       Value="0,0,0,12"/>
    </Style>

    <!-- Etiqueta dos cards de métrica -->
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="Foreground" Value="#9AA0AB"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Valor principal dos cards -->
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize"   Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <!-- Linhas alternadas na tabela -->
    <Style Selector="DataGridRow:nth-child(odd)">
      <Setter Property="Background" Value="#F9FAFC"/>
    </Style>

  </UserControl.Styles>

  <ScrollViewer Background="#F4F6FA">
    <Border Padding="28,24">
      <StackPanel Spacing="20">

        <!-- ══════════════════════════════════════════════════════
             CABEÇALHO
             ══════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="*, Auto">
          <TextBlock Grid.Column="0"
                     Text="DashBoard Principal"
                     FontSize="20"
                     FontWeight="Bold"
                     Foreground="#1A2E5A"
                     VerticalAlignment="Center"/>

          <!-- Ícone de notificações (sino) -->
          <Border Grid.Column="1"
                  Width="36" Height="36"
                  CornerRadius="18"
                  Background="White"
                  BoxShadow="0 2 8 0 #0A000000"
                  VerticalAlignment="Center">
            <TextBlock Text="🔔"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             CARDS DE MÉTRICAS
             ══════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="*, 12, *, 12, *">

          <!-- Receita Total -->
          <Border Grid.Column="0" Classes="sg-card">
            <Grid ColumnDefinitions="*, 100">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="metric-label" Text="Receita Total"/>
                <TextBlock Classes="metric-value" Text="{Binding TotalReceita}" Foreground="#2196F3"/>
              </StackPanel>
              <lvc:CartesianChart Grid.Column="1"
                                  Height="50"
                                  Series="{Binding SparklineReceita}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Despesas -->
          <Border Grid.Column="2" Classes="sg-card">
            <Grid ColumnDefinitions="*, 100">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="metric-label" Text="Despesas"/>
                <TextBlock Classes="metric-value" Text="{Binding TotalDespesa}" Foreground="#E53935"/>
              </StackPanel>
              <lvc:CartesianChart Grid.Column="1"
                                  Height="50"
                                  Series="{Binding SparklineDespesa}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

          <!-- Lucro Líquido -->
          <Border Grid.Column="4" Classes="sg-card">
            <Grid ColumnDefinitions="*, 100">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="metric-label" Text="Lucro Líquido"/>
                <TextBlock Classes="metric-value" Text="{Binding LucroLiquido}" Foreground="#43A047"/>
              </StackPanel>
              <lvc:CartesianChart Grid.Column="1"
                                  Height="50"
                                  Series="{Binding SparklineLucro}"
                                  TooltipPosition="Hidden"
                                  Background="Transparent"/>
            </Grid>
          </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════
             GRÁFICOS PRINCIPAIS
             ══════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="2*, 12, *">

          <!-- Fluxo Financeiro -->
          <Border Grid.Column="0" Classes="sg-card">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top"
                         Classes="section-title"
                         Text="Fluxo Financeiro"/>
              <lvc:CartesianChart Height="240"
                                  Series="{Binding FluxoFinanceiroSeries}"
                                  XAxes="{Binding XAxes}"
                                  YAxes="{Binding YAxes}"
                                  LegendPosition="Top"/>
            </DockPanel>
          </Border>

          <!-- Distribuição Financeira -->
          <Border Grid.Column="2" Classes="sg-card">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top"
                         Classes="section-title"
                         Text="Distribuição Financeira"/>
              <lvc:PieChart Height="240"
                            Series="{Binding DistribuicaoSeries}"
                            LegendPosition="Bottom"/>
            </DockPanel>
          </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════
             TABELA DE MOVIMENTAÇÕES
             ══════════════════════════════════════════════════════ -->
        <Border Classes="sg-card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Classes="section-title"
                       Text="Últimas Movimentações"/>

            <DataGrid ItemsSource="{Binding UltimasMovimentacoes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="Transparent"
                      FontSize="12">

              <DataGrid.Columns>

                <DataGridTemplateColumn Header="Data" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:MovimentacaoItem">
                      <TextBlock Text="{Binding Data}"
                                 VerticalAlignment="Center"
                                 Foreground="#555555"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Tipo" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:MovimentacaoItem">
                      <TextBlock Text="{Binding Tipo}"
                                 VerticalAlignment="Center"
                                 Foreground="#555555"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Categoria" Width="2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:MovimentacaoItem">
                      <TextBlock Text="{Binding Categoria}"
                                 VerticalAlignment="Center"
                                 Foreground="#333333"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Conta" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:MovimentacaoItem">
                      <TextBlock Text="{Binding Conta}"
                                 VerticalAlignment="Center"
                                 Foreground="#555555"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Valor" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:MovimentacaoItem">
                      <TextBlock Text="{Binding Valor}"
                                 VerticalAlignment="Center"
                                 FontWeight="Medium"
                                 Foreground="#1A2E5A"
                                 Margin="10,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

              </DataGrid.Columns>
            </DataGrid>

          </DockPanel>
        </Border>

      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>